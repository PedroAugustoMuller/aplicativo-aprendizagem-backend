# Production .env for the Oracle VM - copy to .env next to
# docker-compose.prod.yml and fill every CHANGE_ME (docs/DEPLOY.md, step 5).
# Never commit the filled copy.
APP_NAME="Quimica API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.CHANGE_ME
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Only this origin may call the API (config/cors.php).
FRONTEND_URL=https://app.CHANGE_ME

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=quimica
DB_USERNAME=quimica
# openssl rand -hex 24
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

BCRYPT_ROUNDS=12

# Read by docker-compose.prod.yml only.
CERTS_DIR=/home/deploy/certs
CLOUDFLARE_IPS_FILE=/home/deploy/cloudflare-ips.conf
HTTPS_PORT=443
